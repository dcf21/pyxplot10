# Tests of lists
load "testlib.ppl"

l = [1, 2, 3]
assert l.len() == 3
assert l[0] == 1
assert l[-1] == 3
assert l[1:] == [2, 3]
call l.append(4)
assert l == [1, 2, 3, 4]
call l.extend([5, 6])
assert l.len() == 6
assert l.pop() == 6
call l.insert(0, 0)
assert l[0] == 0
call l.reverse()
assert l == [5, 4, 3, 2, 1, 0]
call l.sort()
assert l == [0, 1, 2, 3, 4, 5]
assert l.count(3) == 1
assert l.index(4) == 4
assert l.max() == 5
assert l.min() == 0
assert [1, 2] + [3] == [1, 2, 3]
assert range(4) == vector(0, 1, 2, 3)
assert range(2, 8, 3) == vector(2, 5)
sq(x) = x**2
assert [1, 2, 3].map(sq) == [1, 4, 9]

# Lists may hold objects of different types, including other lists
m = [1, "a", [2, 3]]
assert m[2][1] == 3
