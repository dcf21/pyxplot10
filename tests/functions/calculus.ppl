# Tests of numerical integration and differentiation, equation solving and minimisation
load "testlib.ppl"

assert approxAbs(int_dx(x**2, 0, 1), 1/3, 1e-8)
assert approxAbs(int_dx(sin(x), 0, pi), 2, 1e-8)
assert approxAbs(diff_dx(x**3, 2), 12, 1e-5)
assert approxAbs(diff_dx(sin(x), 0), 1, 1e-6)

# solve
solve x**2 = 4 via x
assert approxAbs(abs(x), 2, 1e-6)

# minimize
y = 1
minimize (y - 3)**2 via y
assert approxAbs(y, 3, 1e-4)
