# Tests of the methods of dictionaries
d = {"a": 1, "b": 2, "c": 3}
assert d.len() == 3
assert d.keys().sort() == ["a", "b", "c"]
assert d.values().sort() == [1, 2, 3]
assert d.items().sort() == [["a", 1], ["b", 2], ["c", 3]]
assert d.hasKey("b")
assert !d.hasKey("z")
call d.delete("b")
assert !d.hasKey("b")
assert d.len() == 2
call d.delete("not there")  # Deleting a missing key is not an error
assert d.len() == 2
