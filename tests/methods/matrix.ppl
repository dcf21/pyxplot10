# Tests of the methods of matrices
load "testlib.ppl"

a = matrix([1, 2], [3, 4])
assert a.size() == vector(2, 2)
assert matrix([1, 2, 3], [4, 5, 6]).size() == vector(2, 3)
assert approx(a.det(), -2)
assert a.transpose() == matrix([1, 3], [2, 4])
i = a.inv()
assert approx((a * i)[0][0], 1)
assert approxAbs((a * i)[0][1], 0, 1e-12)
assert approxAbs((a * i)[1][0], 0, 1e-12)
assert approx((a * i)[1][1], 1)
assert !a.symmetric()
assert matrix([1, 2], [2, 1]).symmetric()
assert matrix([1, 0], [0, 5]).diagonal()
assert !a.diagonal()

# Eigenvalues and eigenvectors of a symmetric matrix: each eigenvector v, with eigenvalue lambda, has s*v = lambda*v
# The eigenvalues are listed in ascending order, and the eigenvectors in the same order
s = matrix([4, 1, 2], [1, 3, 0], [2, 0, 5])
ev = s.eigenvalues()
assert approx(ev[0], 1.8548973087995775)  # Computed independently with NumPy
assert approx(ev[1], 3.476023602918134)
assert approx(ev[2], 6.669079088282287)
vecs = s.eigenvectors()
assert vecs.len() == 3
for j = 0 to 2 {
 v = vecs[j]
 lambda = ev[j]
 r = s * v - lambda * v
 assert approxAbs(r.norm(), 0, 1e-12)
 assert approx(v.norm(), 1)
}
