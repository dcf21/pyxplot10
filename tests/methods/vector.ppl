# Tests of the methods of vectors
load "testlib.ppl"

v = vector(3, 1, 2)
assert v.len() == 3
assert v.list() == [3, 1, 2]
assert approx(vector(3, 4).norm(), 5)
assert approx(vector(1, 2, 2).norm(), 3)
assert v.append(5) == vector(3, 1, 2, 5)
assert v.extend([6, 7]) == vector(3, 1, 2, 5, 6, 7)
assert v.insert(1, 0) == vector(3, 0, 1, 2, 5, 6, 7)
assert v.reverse() == vector(7, 6, 5, 2, 1, 0, 3)
assert v.sort() == vector(0, 1, 2, 3, 5, 6, 7)
assert v == vector(0, 1, 2, 3, 5, 6, 7)
double(x) = 2 * x
isOdd(x) = x % 2 == 1
add(a, b) = a + b
assert vector(1, 2, 3).map(double) == vector(2, 4, 6)
assert vector(1, 2, 3, 4, 5).filter(isOdd) == vector(1, 3, 5)
assert vector(1, 2, 3, 4).reduce(add) == 10
assert (vector(3, 4) * unit(m)).norm() == 5 * unit(m)
