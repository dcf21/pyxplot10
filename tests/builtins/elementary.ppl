# Tests of the built-in elementary functions. Expected values come from mathematical identities and known constants.
load "testlib.ppl"

# Absolute values, signs and rounding
assert abs(-3.5) == 3.5
assert abs(-2 * unit(m)) == 2 * unit(m)
assert sgn(-4) == -1
assert sgn(0) == 0
assert sgn(7) == 1
assert sgn(7 * unit(s)) == 1  # Quantities with units are accepted, and the result is dimensionless
assert sgn(-2 * unit(km)) == -1
assert sgn(0 * unit(kg)) == 0
assert sgn(-3 * unit(m)) + 1 == 0
assert floor(2.7) == 2
assert floor(-2.5) == -3
assert ceil(2.1) == 3
assert ceil(-2.5) == -2
assert round(2.5) == 3
assert round(-2.5) == -3  # Halfway values are rounded away from zero
assert round(2.4) == 2
assert mod(7, 3) == 1
assert approx(mod(7.5, 2), 1.5)
assert heaviside(-1) == 0
assert heaviside(0) == 1
assert heaviside(2) == 1
assert tophat(0.5, 1) == 1
assert tophat(1, 1) == 1
assert tophat(1.5, 1) == 0
assert tophat(-1.5, -2) == 1
assert finite(1)
set numerics errors quiet
assert !finite(1/0)  # With errors quiet, 1/0 is NaN rather than an error
set numerics errors explicit
assert !finite(nan)

# Powers, roots and logarithms
assert approx(sqrt(16), 4)
assert approx(sqrt(4 * unit(m**2)), 2 * unit(m))
assert approx(root(27, 3), 3)
assert approx(root(16, 4), 2)
assert approx(pow(2, 10), 1024)
assert approx(pow(9, 0.5), 3)
assert approx(exp(1), e)
assert approx(exp(0), 1)
assert approx(expm1(1e-10), 1e-10)  # Accurate for small arguments, where exp(x)-1 would lose precision
assert approx(expm1(1), e - 1)
assert approx(log(e**3), 3)
assert approx(ln(e), 1)
assert approx(log10(1e5), 5)
assert approx(logn(81, 3), 4)
assert approx(ldexp(3, 4), 48)
assert approx(ldexp(1, -2), 0.25)

# Quadrature sums, extrema and sums of several arguments
assert approx(hypot(3, 4), 5)
assert approx(hypot(1, 2, 2), 3)
assert approx(hypot(3 * unit(m), 4 * unit(m)), 5 * unit(m))
assert max(3, 9, 2) == 9
assert min(3, 9, 2) == 2
assert max(-1, -5) == -1
assert max(1 * unit(km), 900 * unit(m)) == 1 * unit(km)
assert sum(1, 2, 3, 4) == 10
assert sum(1 * unit(m), 50 * unit(cm)) == 1.5 * unit(m)

# Angles
assert approx(degrees(pi), 180)
assert approx(radians(90), pi / 2)

# Complex numbers
set numerics complex
z = 3 + 4 * i
assert Re(z) == 3
assert Im(z) == 4
assert approx(arg(i), pi / 2)
assert approx(arg(-1), pi)
assert conjugate(z) == 3 - 4 * i
assert approx(abs(z), 5)
assert approx(sqrt(-4), 2 * i)
assert approx(exp(i * pi / 2), i)
assert approx(log(-1), i * pi)
