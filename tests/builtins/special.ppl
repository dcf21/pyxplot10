# Tests of the built-in special functions. The expected values were computed independently with SciPy, or come
# from closed-form expressions, and are compared to a relative precision of 1e-9 (or 1e-6 where noted).
load "testlib.ppl"

# Airy functions
assert approx(airy_ai(0.7), 0.18916240039814997)
assert approx(airy_ai_diff(0.7), -0.19985119158228049)
assert approx(airy_bi(0.7), 0.9733286558781656)
assert approx(airy_bi_diff(0.7), 0.65440591917214)

# Cylindrical Bessel functions
assert approx(besselJ(0, 0), 1)
assert approx(besselJ(2, 3.5), 0.4586291841943075)
assert approx(besselY(1, 2.5), 0.1459181379667858)
assert approx(besselI(3, 1.5), 0.08077411301609232)
assert approx(besselK(2, 1.5), 0.5836559632566507)
# Spherical Bessel functions, e.g. j_0(x)=sin(x)/x, y_0(x)=-cos(x)/x, i_0(x)=sinh(x)/x, k_0(x)=(pi/2)exp(-x)/x
assert approx(besselj(0, 1.3), sin(1.3) / 1.3)
assert approx(bessely(0, 1.3), -cos(1.3) / 1.3)
assert approx(besseli(0, 1.3), sinh(1.3) / 1.3)
assert approx(besselk(0, 1.3), pi / 2 * exp(-1.3) / 1.3)
assert approx(besselj(2, 2.5), 0.26006672948890525)
assert approx(bessely(2, 2.5), -0.4539045012036614)
assert approx(besseli(2, 2.5), 0.6382221025369847)
assert approx(besselk(2, 2.5), 0.13822240895466806)

# Gamma, beta, error and exponential integral functions
assert approx(gamma(5), 24)
assert approx(gamma(0.5), sqrt(pi))
assert approx(beta(2, 3), 1 / 12)
assert approx(beta(1.5, 2.5), 0.19634954084936204)
assert approx(erf(0.8), 0.7421009647076605)
assert approx(erfc(0.8), 0.2578990352923395)
assert approx(erf(0.8) + erfc(0.8), 1)
# expint(n,x) is the integral of exp(-xt)/t**n between one and infinity
assert approx(expint(1, 1), 0.2193839343955205)
assert approx(expint(3, 0.5), 0.22160436427517846)

# Complete elliptic integrals of modulus k (SciPy uses the parameter m=k**2)
assert approx(ellipticintK(0), pi / 2)
assert approx(ellipticintE(0), pi / 2)
assert approx(ellipticintK(0.6), 1.7507538029157526)
assert approx(ellipticintE(0.6), 1.4180833944487243)
# ellipticintP(k,n) is the integral of 1/((1+n*sin(t)**2) sqrt(1-k**2 sin(t)**2)) from 0 to pi/2
assert approx(ellipticintP(0.6, 0.3), 1.5243814243493583)

# Hypergeometric functions
assert approx(hyperg_0F1(0.5, 1), cosh(2))  # 0F1(;1/2;x) = cosh(2*sqrt(x))
assert approx(hyperg_1F1(1, 1, 0.7), exp(0.7))  # 1F1(a;a;x) = exp(x)
assert approx(hyperg_1F1(0.5, 1.5, 2), 2.3644538928052086)
assert approx(hyperg_2F1(1, 1, 2, 0.5), 2 * ln(2))  # 2F1(1,1;2;x) = -ln(1-x)/x
assert approx(hyperg_U(1, 1, 1), 0.5963473623231941)
# 2F0(a,b,x) = (-1/x)**a U(a,1+a-b,-1/x), defined for x<0
assert approx(hyperg_2F0(1, 1, -1), 0.5963473623231941)
assert approx(hyperg_2F0(0.5, 2, -0.5), 0.7358923121358393)

# Jacobi elliptic functions sn, cn and dn, of parameter m
assert approx(jacobi_sn(0.8, 0), sin(0.8))
assert approx(jacobi_cn(0.8, 0), cos(0.8))
assert approx(jacobi_dn(0.8, 0), 1)
assert approx(jacobi_sn(0.8, 0.4), 0.6962608593364514)
assert approx(jacobi_cn(0.8, 0.4), 0.7177888378597609)
assert approx(jacobi_dn(0.8, 0.4), 0.8978242179304512)

# Lambert W function: W(x) exp(W(x)) = x, on the principal branch (W>=-1) and the lower branch (W<=-1)
w = lambert_W0(1)
assert approx(w * exp(w), 1)
assert approx(w, 0.5671432904097838)
w = lambert_W1(-0.1)
assert approx(w * exp(w), -0.1)
assert w < -1

# Legendre functions
assert approx(legendreP(2, 0.5), (3 * 0.5**2 - 1) / 2)
assert approx(legendreP(5, 0.3), 0.3453862499999999)
assert approx(legendreQ(0, 0.5), atanh(0.5))  # Q_0(x) = atanh(x)
assert approx(legendreQ(2, 0.4), -0.7101487218503365)

# Riemann zeta function
assert approx(zeta(2), pi**2 / 6)
assert approx(zeta(4), pi**4 / 90)

# Zernike polynomials: R(n,m,r) is the radial part; Z(n,m,r,phi) = R cos(m phi) for m>0, R sin(|m| phi) for m<0
assert approx(zernikeR(2, 0, 0.5), 2 * 0.5**2 - 1)
assert approx(zernikeR(3, 1, 0.5), 3 * 0.5**3 - 2 * 0.5)
assert approx(zernikeR(4, 2, 0.6), 4 * 0.6**4 - 3 * 0.6**2)
assert zernikeR(3, 0, 0.5) == 0  # Zero when n-m is odd
assert approx(zernike(2, 0, 0.5, 1), 2 * 0.5**2 - 1)
assert approx(zernike(4, 2, 0.6, 0.3), (4 * 0.6**4 - 3 * 0.6**2) * cos(0.6))
assert approx(zernike(4, -2, 0.6, 0.3), (4 * 0.6**4 - 3 * 0.6**2) * sin(0.6))
