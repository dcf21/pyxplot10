# Tests of how the print command displays values of each type
print 1
print -2.5
print 1e20
print 1.23456789e-20
print pi
print "a string"
print [1, "two", 3.5]
print {"a": 1}
print vector(1, 2, 3)
print matrix([1, 2], [3, 4])
print true, false
print 2 * unit(km)
print 1/3
set numerics sigfig 12
print 1/3
