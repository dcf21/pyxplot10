# Tests of the string substitution operator %, which formats numbers in the style of printf()
print "%d" % (42)
print "%5d|" % (42)
print "%-5d|" % (42)
print "%.3f" % (pi)
print "%10.2e|" % (12345.678)
print "%*.*f|" % (10, 2, pi)
print "%*d|" % (6, 42)
print "%x" % (255)
print "%o" % (8)
print "%s and %s" % ("a", 2)
print "%s" % ([1, 2])
print "%.2f" % (3 * unit(m))
print "100%%" % ()
set numerics complex
print "%.2f" % (1 + 2 * i)
